<resources>
    <style name="ForkdexTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#8FB8FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101722</item>
        <item name="android:navigationBarColor">#101722</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:dialogTheme">@style/ForkdexDialogTheme</item>
    </style>

    <style name="ForkdexDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#A9C9FF</item>
        <item name="android:windowBackground">@drawable/forkdex_glass_dialog</item>
        <item name="android:windowMinWidthMajor">82%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.34</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
